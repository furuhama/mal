(println [1 2 3])
(println {:a 1 :b 2})
(println #{1 2 3})
(println (first [10 20 30]))
(println (rest [10 20 30]))
(println (next [10]))
(println (next []))
(println (count [1 2 3]))
(println (count "hello"))
(println (nth [10 20 30] 1))
(println (get {:a 1} :a))
(println (get {:a 1} :b))
(println (assoc {:a 1} :b 2))
(println (dissoc {:a 1 :b 2} :a))
(println (contains? {:a 1} :a))
(println (contains? #{1 2} 2))
(println (conj [1 2] 3))
(println (conj '(1 2) 3 4))
(println (conj {:a 1} [:b 2]))
(println (conj #{1} 2 2))
(println (keys {:a 1 :b 2}))
(println (vals {:a 1 :b 2}))
(println (merge {:a 1} {:a 10 :b 2}))
(println (vec '(1 2 3)))
(println (seq [1 2]))
(println (seq []))
(println (empty? []))
(println (empty? nil))

(println (str "a" "b" 1))
(println (str nil))
(println (pr-str "a\nb"))
(println (str :kw))
(println (str [1 2]))
(println (read-string "(+ 1 2)"))
(println (name :foo))
(println (name 'bar))
(println (keyword "baz"))
(println (symbol "qux"))
(println (int 3.7))
(println (float 3))
(println (str "value=" 42))

(println (map (fn [x] (* x x)) [1 2 3]))
(println (filter (fn [x] (even? x)) [1 2 3 4 5 6]))
(println (reduce + [1 2 3 4]))
(println (reduce + 10 [1 2 3 4]))
(println (apply + [1 2 3]))
(println (apply + 1 2 [3 4]))
(println ((partial + 10) 5))
(println ((comp inc inc) 5))
(println ((comp inc +) 1 2))
(println (identity 7))
(println (map inc '(1 2 3)))
(defn my-reduce [f acc coll]
  (if (empty? coll) acc (recur f (f acc (first coll)) (rest coll))))
(println (my-reduce + 0 [1 2 3 4 5]))
